{
  "name": "vythos",
  "version": "1.0.0",
  "settings": [
    {
      "name": "Vythos API Key",
      "description": "Per-tool API key generated on the AI tools page in your Vythos workspace",
      "envVar": "VYTHOS_API_KEY",
      "sensitive": true
    }
  ],
  "mcpServers": {
    "vythos": {
      "httpUrl": "https://api.vythos.tech/api/mcp/sse",
      "headers": {
        "Authorization": "Bearer ${VYTHOS_API_KEY}"
      }
    }
  }
}
