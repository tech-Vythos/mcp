{
  "$schema": "https://cursor.com/schemas/cursor-plugin/plugin.json",
  "name": "vythos",
  "displayName": "Vythos",
  "version": "1.0.0",
  "description": "Sync client Playbook rules, approved rates, and project memory directly into Cursor.",
  "author": {
    "name": "Vythos",
    "email": "support@vythos.tech"
  },
  "homepage": "https://vythos.tech",
  "repository": "https://github.com/tech-Vythos/mcp",
  "license": "MIT",
  "category": "productivity",
  "keywords": ["playbook", "client-context", "freelance", "agency", "memory", "rates"],
  "mcpServers": "./mcp.json",
  "variables": {
    "type": "object",
    "required": ["VYTHOS_API_KEY"],
    "properties": {
      "VYTHOS_API_KEY": {
        "type": "string",
        "description": "Your per-tool Vythos API key from https://vythos.tech"
      }
    }
  }
}
